---
import site from "../data/site.json";
---

<section class="relative px-6 sm:px-10 py-16 sm:py-20 bg-vert-chateau text-center texture-grain overflow-hidden">
  <div class="relative max-w-xl mx-auto reveal reveal--scale">
    <p class="eyebrow text-or-clair text-xs sm:text-sm">Embarquement</p>
    <h2 class="font-serif text-4xl sm:text-5xl text-ivoire font-medium mt-2">Prêts à nous rejoindre ?</h2>
    <p class="text-ivoire/75 text-sm sm:text-base mt-3">
      Réponse souhaitée avant le {site.rsvpDeadlineLabel}
    </p>
    <a href="/rsvp" class="btn btn-solid inline-flex mt-8">
      CONFIRMER VOTRE EMBARQUEMENT
    </a>
  </div>
</section>
