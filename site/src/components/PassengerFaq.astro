---
import Icon from "./Icon.astro";
import faq from "../data/faq.json";
---

<section id="informations-passagers" class="px-6 sm:px-10 py-16 sm:py-24 bg-kraft scroll-mt-20">
  <div class="max-w-2xl mx-auto reveal">
    <div class="divide-y divide-vert-chateau/15">
      {faq.items.map((item) => (
        <details class="faq-item group py-5" name="faq">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
            <span class="font-serif text-base sm:text-lg text-vert-chateau">{item.q}</span>
            <Icon name="chevron-down" class="faq-chevron w-4 h-4 text-vert-chateau shrink-0 transition-transform duration-300" />
          </summary>
          <div class="faq-panel overflow-hidden h-0 opacity-0">
            <p class="text-sm text-ardoise/70 mt-3 leading-relaxed pr-8">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-panel {
    transition: height 0.35s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-panel { transition: none; }
  }
</style>

<script>
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let openItem: HTMLDetailsElement | null = null;

  function closeItem(details: HTMLDetailsElement, immediate = false) {
    const panel = details.querySelector<HTMLElement>(".faq-panel");
    const chevron = details.querySelector<HTMLElement>(".faq-chevron");
    chevron?.classList.remove("rotate-180");
    if (!panel) {
      details.open = false;
      return;
    }
    if (immediate || prefersReduced) {
      panel.style.height = "0px";
      panel.style.opacity = "0";
      details.open = false;
      return;
    }
    panel.style.height = panel.scrollHeight + "px";
    requestAnimationFrame(() => {
      panel.style.height = "0px";
      panel.style.opacity = "0";
    });
    panel.addEventListener(
      "transitionend",
      function handler() {
        details.open = false;
        panel.removeEventListener("transitionend", handler);
      },
      { once: true }
    );
  }

  function openItemAnimated(details: HTMLDetailsElement) {
    const panel = details.querySelector<HTMLElement>(".faq-panel");
    const chevron = details.querySelector<HTMLElement>(".faq-chevron");
    chevron?.classList.add("rotate-180");
    details.open = true;
    if (!panel) return;
    if (prefersReduced) {
      panel.style.height = "auto";
      panel.style.opacity = "1";
      return;
    }
    const target = panel.scrollHeight;
    panel.style.height = "0px";
    requestAnimationFrame(() => {
      panel.style.height = target + "px";
      panel.style.opacity = "1";
    });
    panel.addEventListener(
      "transitionend",
      function handler() {
        panel.style.height = "auto";
        panel.removeEventListener("transitionend", handler);
      },
      { once: true }
    );
  }

  document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((details) => {
    const summary = details.querySelector("summary");
    summary?.addEventListener("click", (e) => {
      e.preventDefault();
      const isOpen = details.open;
      if (isOpen) {
        closeItem(details);
        if (openItem === details) openItem = null;
        return;
      }
      if (openItem && openItem !== details) closeItem(openItem);
      openItem = details;
      openItemAnimated(details);
    });
  });
</script>
