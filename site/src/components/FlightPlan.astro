---
import schedule from "../data/schedule.json";
import Icon from "./Icon.astro";

const steps = schedule.saturday.steps;
---

<section id="plan-de-vol" class="px-6 sm:px-10 py-20 sm:py-28 bg-ivoire scroll-mt-20 overflow-hidden">
  <div class="max-w-3xl mx-auto text-center reveal">
    <h2 class="font-serif text-4xl sm:text-5xl text-vert-chateau font-medium">Plan de vol</h2>
  </div>

  <!-- mobile: vertical timeline -->
  <ol class="mt-12 max-w-md mx-auto sm:hidden">
    {steps.map((step, i) => (
      <li class="flex gap-4 reveal reveal--left" style={`transition-delay:${0.1 + i * 0.12}s`}>
        <div class="flex flex-col items-center">
          <span class="w-2.5 h-2.5 rounded-full bg-or shrink-0"></span>
          {i < steps.length - 1 && <span class="w-px flex-1 bg-gris-piste min-h-[52px]"></span>}
        </div>
        <div class="pb-9 flex items-start gap-4">
          <Icon name={step.icon as any} class="w-7 h-7 text-vert-chateau mt-0.5 shrink-0" />
          <div>
            <p class="font-serif text-xl sm:text-2xl text-vert-chateau font-semibold">{step.time} · {step.title}</p>
            {step.place && (
              step.mapsUrl ? (
                <a
                  href={step.mapsUrl}
                  target={step.mapsUrl.startsWith("http") ? "_blank" : undefined}
                  rel={step.mapsUrl.startsWith("http") ? "noopener" : undefined}
                  class="inline text-sm text-sauge-deep underline decoration-sauge-deep/40 underline-offset-2 hover:text-vert-chateau hover:decoration-vert-chateau mt-1.5"
                >
                  {step.place}{step.address && `, ${step.address}`}
                </a>
              ) : (
                <p class="text-sm text-ardoise/60 mt-1">{step.place}</p>
              )
            )}
          </div>
        </div>
      </li>
    ))}
  </ol>

  <!-- desktop: horizontal trajectory, dessinée au scroll -->
  <div class="mt-16 hidden sm:block">
    <div id="plan-de-vol-track" class="max-w-5xl mx-auto relative">
      <svg class="absolute left-0 right-0 top-[6px] w-full h-[2px] overflow-visible" preserveAspectRatio="none" aria-hidden="true">
        <line id="plan-de-vol-line" x1="0" y1="1" x2="100%" y2="1" stroke="var(--color-gris-piste)" stroke-width="1.5" stroke-dasharray="1 7" stroke-linecap="round" />
      </svg>
      <svg id="plan-de-vol-plane" class="absolute top-[-7px] left-0" width="18" height="18" viewBox="0 0 24 24" fill="var(--color-or)" aria-hidden="true">
        <path d="M2 13.5l7-1.2 4.8-7.8c.3-.5 1-.6 1.4-.2.3.3.4.7.3 1.1l-2 7.3 5.7-.6c.6-.1 1.2.3 1.3.9.1.5-.2 1-.7 1.2l-6.4 2.6-1.9 4.9c-.2.5-.8.7-1.2.4-.3-.2-.5-.5-.4-.9l.6-4.9-7.5.8c-.5.1-.9-.3-1-.8-.1-.3 0-.6.2-.8Z" transform="rotate(90 12 12)"/>
      </svg>
      <ol class="relative flex justify-between">
        {steps.map((step, i) => (
          <li class="flex-1 flex flex-col items-center gap-3 text-center px-2 reveal reveal--scale" style={`transition-delay:${0.15 + i * 0.1}s`}>
            <span class="w-3.5 h-3.5 rounded-full bg-or ring-4 ring-ivoire"></span>
            <Icon name={step.icon as any} class="w-8 h-8 text-vert-chateau" />
            <p class="font-serif text-2xl text-vert-chateau font-semibold">{step.time}</p>
            <p class="text-base text-ardoise/70">{step.title}</p>
            {step.place && (
              step.mapsUrl ? (
                <a
                  href={step.mapsUrl}
                  target={step.mapsUrl.startsWith("http") ? "_blank" : undefined}
                  rel={step.mapsUrl.startsWith("http") ? "noopener" : undefined}
                  class="inline-block text-sm text-sauge-deep underline decoration-sauge-deep/40 underline-offset-2 hover:text-vert-chateau hover:decoration-vert-chateau max-w-[190px] leading-snug"
                >
                  {step.place}{step.address && `, ${step.address}`}
                </a>
              ) : (
                <p class="text-sm text-ardoise/50 max-w-[180px] leading-snug">{step.place}</p>
              )
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>

</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const track = document.getElementById("plan-de-vol-track");
  const line = document.getElementById("plan-de-vol-line");
  const plane = document.getElementById("plan-de-vol-plane");

  if (track && line && plane && !prefersReduced) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.set(line, { strokeDashoffset: 0 });
    gsap.fromTo(
      line,
      { scaleX: 0 },
      {
        scaleX: 1,
        ease: "none",
        transformOrigin: "left center",
        scrollTrigger: { trigger: track, start: "top 75%", end: "bottom 60%", scrub: 0.5 },
      }
    );
    gsap.fromTo(
      plane,
      { left: "0%" },
      {
        left: "calc(100% - 18px)",
        ease: "none",
        scrollTrigger: { trigger: track, start: "top 75%", end: "bottom 60%", scrub: 0.5 },
      }
    );
  }
</script>
