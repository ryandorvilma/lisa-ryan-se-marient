---
import schedule from "../data/schedule.json";
const { sunday } = schedule;
---

<section id="escale-gourmande" class="relative px-6 sm:px-10 py-20 sm:py-28 bg-kraft scroll-mt-20 overflow-hidden">
  <!-- motif eucalyptus discret, repris du feuillet "brunch" du faire-part -->
  <svg class="absolute -top-6 -right-6 w-32 h-32 sm:w-44 sm:h-44 text-sauge-deep/20 reveal reveal--scale" style="transition-delay:.1s" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <ellipse cx="70" cy="20" rx="9" ry="14" transform="rotate(35 70 20)"/>
    <ellipse cx="55" cy="30" rx="8" ry="12" transform="rotate(20 55 30)"/>
    <ellipse cx="82" cy="35" rx="7" ry="11" transform="rotate(55 82 35)"/>
    <ellipse cx="60" cy="48" rx="7" ry="10" transform="rotate(10 60 48)"/>
  </svg>
  <svg class="absolute -bottom-8 -left-8 w-32 h-32 sm:w-44 sm:h-44 text-sauge-deep/15 reveal reveal--scale" style="transition-delay:.15s" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <ellipse cx="30" cy="80" rx="9" ry="14" transform="rotate(-35 30 80)"/>
    <ellipse cx="45" cy="70" rx="8" ry="12" transform="rotate(-20 45 70)"/>
    <ellipse cx="18" cy="65" rx="7" ry="11" transform="rotate(-55 18 65)"/>
    <ellipse cx="40" cy="52" rx="7" ry="10" transform="rotate(-10 40 52)"/>
  </svg>

  <div class="relative max-w-2xl mx-auto text-center reveal">
    <p class="eyebrow text-sauge-deep text-xs sm:text-sm">{sunday.dateLabel}</p>
    <h2 class="font-serif text-4xl sm:text-5xl text-vert-chateau font-medium mt-2">{sunday.title}</h2>
    <p class="eyebrow text-vert-chateau/80 text-sm mt-3">{sunday.time} · {sunday.place}</p>
    <p class="mt-6 text-sm sm:text-base text-ardoise/75 leading-relaxed">{sunday.text}</p>
  </div>
</section>
