---
// Tampon rond façon cachet postal — repris du dos du boarding pass (faire-part, feuillet 2).
interface Props {
  class?: string;
  color?: string;
}
const { class: className = "w-16 h-16", color = "currentColor" } = Astro.props;
---

<svg viewBox="0 0 60 60" class={className} fill="none" stroke={color} aria-hidden="true">
  <circle cx="30" cy="30" r="26" stroke-width="1"/>
  <circle cx="30" cy="30" r="20" stroke-width="1"/>
  <path d="M20 30 l14 -7 l-3.5 7 l3.5 7 z" fill={color} stroke="none"/>
  <text x="30" y="14" text-anchor="middle" font-size="5.5" letter-spacing="1.5" fill={color} stroke="none" font-family="Cormorant Garamond, serif">LISA &amp; RYAN</text>
  <text x="30" y="50" text-anchor="middle" font-size="5.5" letter-spacing="1.5" fill={color} stroke="none" font-family="Cormorant Garamond, serif">31 · 07 · 2027</text>
</svg>
