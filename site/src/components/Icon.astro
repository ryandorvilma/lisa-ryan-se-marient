---
interface Props {
  name:
    | "plane"
    | "church"
    | "toast"
    | "dinner"
    | "cake"
    | "map-pin"
    | "bed"
    | "car"
    | "shirt"
    | "baby"
    | "gift"
    | "info"
    | "accessibility"
    | "instagram"
    | "menu"
    | "close"
    | "chevron-down";
  class?: string;
}
const { name, class: className = "w-5 h-5" } = Astro.props;
---

{name === "plane" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M2 13.5l7-1.2 4.8-7.8c.3-.5 1-.6 1.4-.2.3.3.4.7.3 1.1l-2 7.3 5.7-.6c.6-.1 1.2.3 1.3.9.1.5-.2 1-.7 1.2l-6.4 2.6-1.9 4.9c-.2.5-.8.7-1.2.4-.3-.2-.5-.5-.4-.9l.6-4.9-7.5.8c-.5.1-.9-.3-1-.8-.1-.3 0-.6.2-.8Z"/>
  </svg>
)}

{name === "church" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M12 2v3M10.5 3.5h3M5 21V11L12 6l7 5v10M9 21v-6a3 3 0 0 1 6 0v6M2 21h20"/>
  </svg>
)}

{name === "toast" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M6 3l3 3-5 5a2.8 2.8 0 0 0 4 4l5-5 3 3M14 15l6 6M6 21l3-3M2 6l4-4M18 2l4 4"/>
  </svg>
)}

{name === "dinner" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M2 12a10 8 0 0 1 20 0Z M2 12h20 M12 12V4"/>
  </svg>
)}

{name === "cake" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M4 21v-7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v7M4 21h16M8 12V8M12 12V8M16 12V8M8 4v2M12 3v3M16 4v2"/>
  </svg>
)}

{name === "map-pin" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z"/>
    <circle cx="12" cy="9" r="2.4"/>
  </svg>
)}

{name === "bed" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7M3 18v2M21 18v2M3 13h18M6 11V9a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
  </svg>
)}

{name === "car" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M3 16V11l2.5-5h13L21 11v5M3 16h18M6.5 16v2.5M17.5 16v2.5M6 13h.01M18 13h.01"/>
  </svg>
)}

{name === "shirt" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M8 3l4 2 4-2 4 4-3 3v11H7V10L4 7Z"/>
  </svg>
)}

{name === "baby" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <circle cx="12" cy="8" r="4.2"/>
    <path d="M5 21c0-4 3-6 7-6s7 2 7 6"/>
  </svg>
)}

{name === "gift" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M4 9h16v4H4zM4 13h16v8H4zM12 9v12M12 9C10.5 9 8.5 7.8 8.5 6.2 8.5 5 9.4 4 10.5 4c1.4 0 1.9 1.6 1.5 5M12 9c1.5 0 3.5-1.2 3.5-2.8C15.5 5 14.6 4 13.5 4 12.1 4 11.6 5.6 12 9Z"/>
  </svg>
)}

{name === "info" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="9"/>
    <path d="M12 11v6M12 7.5v.01"/>
  </svg>
)}

{name === "accessibility" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <circle cx="12" cy="4.5" r="1.6" fill="currentColor" stroke="none"/>
    <path d="M12 7v5l4.5 2M12 12l-3 3M9 15l-2.5 4M10.5 19h4"/>
    <path d="M8.5 9.5H12"/>
  </svg>
)}

{name === "instagram" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5"/>
    <circle cx="12" cy="12" r="4.2"/>
    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
  </svg>
)}

{name === "menu" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M3 6h18M3 12h18M3 18h18"/>
  </svg>
)}

{name === "close" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
    <path d="M5 5l14 14M19 5L5 19"/>
  </svg>
)}

{name === "chevron-down" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class={className} aria-hidden="true">
    <path d="M6 9l6 6 6-6"/>
  </svg>
)}
