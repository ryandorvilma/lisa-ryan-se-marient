---
import site from "../data/site.json";
import Countdown from "./Countdown.astro";
import WorldMap from "./WorldMap.astro";

const [firstName, secondName] = site.coupleNames;

// Silhouette de nuage (icône "cloud" classique) réutilisée pour toutes les instances.
const CLOUD_PATH =
  "M537.6 226.6c4.1-10.7 6.4-22.4 6.4-34.6 0-53-43-96-96-96-19.7 0-38.1 6-53.3 16.1C367 64.2 315.3 32 256 32c-88.4 0-160 71.6-160 160 0 2.7.1 5.4.2 8.1C40.2 219.8 0 273.2 0 336c0 79.5 64.5 144 144 144h368c70.7 0 128-57.3 128-128 0-61.9-44-113.6-102.4-125.4z";

const clouds = [
  { pos: "top:2%; left:-7%;", width: 280, opacity: 0.42, blur: 1, anim: "a", dur: "42s" },
  { pos: "top:8%; right:2%;", width: 190, opacity: 0.32, blur: 2, anim: "b", dur: "50s" },
  { pos: "top:32%; left:36%;", width: 150, opacity: 0.15, blur: 4, anim: "a", dur: "62s" },
  { pos: "top:44%; left:0%;", width: 230, opacity: 0.28, blur: 2, anim: "b", dur: "46s" },
  { pos: "top:56%; right:-6%;", width: 300, opacity: 0.38, blur: 1, anim: "a", dur: "55s" },
  { pos: "bottom:12%; left:12%;", width: 180, opacity: 0.26, blur: 3, anim: "b", dur: "44s" },
  { pos: "bottom:4%; right:16%;", width: 240, opacity: 0.3, blur: 2, anim: "a", dur: "48s" },
  { pos: "bottom:-6%; left:48%;", width: 340, opacity: 0.2, blur: 3, anim: "b", dur: "58s" },
];
---

<section id="hero" class="relative min-h-[100svh] flex flex-col items-center justify-center overflow-hidden bg-sauge px-6 py-28 text-center texture-grain">
  <div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(circle_at_30%_20%,white,transparent_55%)]" aria-hidden="true"></div>
  <WorldMap id="hero-worldmap" class="absolute inset-0 w-full h-full text-ivoire" opacity={0.1} />

  <div class="hero-clouds absolute inset-0 overflow-hidden" aria-hidden="true">
    {clouds.map((c) => (
      <svg
        class={`hero-cloud hero-cloud--${c.anim}`}
        viewBox="0 0 640 512"
        style={`${c.pos} width:${c.width}px; opacity:${c.opacity}; filter:blur(${c.blur}px); animation-duration:${c.dur};`}
      >
        <path d={CLOUD_PATH} fill="var(--color-ivoire)" />
      </svg>
    ))}
  </div>

  <div class="hero-orbit-wrap relative reveal reveal--scale">
    <div class="hero-orbit" aria-hidden="true">
      <svg class="hero-orbit__svg" viewBox="0 0 600 300" preserveAspectRatio="none">
        <path
          id="hero-orbit-path"
          d="M 35,150 A 265,138 0 1 1 565,150 A 265,138 0 1 1 35,150 Z"
          fill="none"
          stroke="var(--color-or-clair)"
          stroke-width="1.4"
          stroke-dasharray="3 8"
          stroke-linecap="round"
          opacity="0.65"
          vector-effect="non-scaling-stroke"
        />
        <g>
          <path
            d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2.5 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"
            fill="var(--color-or-clair)"
            transform="translate(-11,-11) rotate(90 12 12) translate(12 12) scale(1.9) translate(-12 -12)"
          />
          <animateMotion dur="16s" repeatCount="indefinite" rotate="auto" calcMode="linear">
            <mpath href="#hero-orbit-path"></mpath>
          </animateMotion>
        </g>
      </svg>
    </div>

    <p class="eyebrow text-ivoire/90 text-sm sm:text-lg xl:text-xl hero-enter" style="animation-delay:.2s">
      {site.tagline}
    </p>

    <h1 class="font-script text-6xl sm:text-8xl lg:text-9xl xl:text-[10.5rem] 2xl:text-[12rem] leading-none text-or-clair mt-3 hero-enter" style="animation-delay:.32s">
      {firstName} &amp; {secondName}
    </h1>

    <p class="eyebrow text-ivoire text-2xl sm:text-4xl xl:text-5xl mt-4 hero-enter" style="animation-delay:.44s">
      {site.weddingDateShort}
    </p>

    <div class="mt-8 xl:mt-10 hero-enter" style="animation-delay:.56s">
      <Countdown />
    </div>

    <div class="mt-10 xl:mt-12 flex flex-col sm:flex-row gap-3 xl:gap-4 w-full max-w-md xl:max-w-xl mx-auto hero-enter" style="animation-delay:.68s">
      <a
        href="#notre-histoire"
        class="btn btn-outline flex-1 border-ivoire/80 text-ivoire hover:bg-ivoire/10 xl:text-sm xl:py-5 xl:px-8"
      >
        DÉCOUVRIR NOS ESCALES
      </a>
      <a
        href="/rsvp"
        class="btn btn-solid flex-1 xl:text-sm xl:py-5 xl:px-8"
      >
        CONFIRMER VOTRE EMBARQUEMENT
      </a>
    </div>
  </div>

  <button
    type="button"
    class="absolute bottom-7 left-1/2 -translate-x-1/2 text-ivoire/70 animate-bounce"
    onclick="document.getElementById('notre-histoire')?.scrollIntoView({behavior:'smooth'})"
    aria-label="Découvrir la suite"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="w-6 h-6" aria-hidden="true">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </button>
</section>

<style>
  .hero-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-orbit__svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  .hero-clouds {
    z-index: 0;
    pointer-events: none;
  }
  .hero-cloud {
    position: absolute;
    height: auto;
    animation-name: cloud-drift-a;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  .hero-cloud--b {
    animation-name: cloud-drift-b;
    animation-direction: alternate-reverse;
  }
  @keyframes cloud-drift-a {
    from { transform: translate(0, 0); }
    to { transform: translate(34px, -14px); }
  }
  @keyframes cloud-drift-b {
    from { transform: translate(0, 0); }
    to { transform: translate(-30px, 12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cloud { animation: none; }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const orbitSvg = document.querySelector<SVGSVGElement>(".hero-orbit__svg");
  if (prefersReduced) orbitSvg?.pauseAnimations();

  function layoutHeroOrbit() {
    const wrap = document.querySelector<HTMLElement>(".hero-orbit-wrap");
    const orbitDiv = document.querySelector<HTMLElement>(".hero-orbit");
    const path = document.getElementById("hero-orbit-path");
    if (!wrap || !orbitDiv || !orbitSvg || !path) return;

    const margin = 100;
    const w = wrap.offsetWidth;
    const h = wrap.offsetHeight;
    const vbW = w + margin * 2;
    const vbH = h + margin * 2;

    orbitDiv.style.inset = `${-margin}px`;
    orbitSvg.setAttribute("viewBox", `0 0 ${vbW} ${vbH}`);

    // Rectangle arrondie plutôt qu'une ellipse pure : une ellipse se resserre dès qu'on
    // s'écarte du centre vertical, ce qui peut couper à travers un élément large (le "Lisa & Ryan"
    // en script) qui n'est pas exactement au milieu du bloc. Le contour arrondi garde une marge
    // constante autour de tout le rectangle de contenu, quelle que soit la position des éléments.
    const planeClearance = 34;
    const x = planeClearance;
    const y = planeClearance;
    const rw = vbW - planeClearance * 2;
    const rh = vbH - planeClearance * 2;
    const r = Math.min(rw, rh) * 0.28;
    path.setAttribute(
      "d",
      `M ${x + r},${y} H ${x + rw - r} A ${r},${r} 0 0 1 ${x + rw},${y + r} V ${y + rh - r} A ${r},${r} 0 0 1 ${x + rw - r},${y + rh} H ${x + r} A ${r},${r} 0 0 1 ${x},${y + rh - r} V ${y + r} A ${r},${r} 0 0 1 ${x + r},${y} Z`
    );
  }

  layoutHeroOrbit();
  window.addEventListener("resize", layoutHeroOrbit);
  document.fonts?.ready.then(layoutHeroOrbit).catch(() => {});
  window.setTimeout(layoutHeroOrbit, 400);

  const map = document.getElementById("hero-worldmap");
  const hero = document.getElementById("hero");
  if (map && hero && !prefersReduced) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.to(map, {
      yPercent: 12,
      ease: "none",
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.6 },
    });
  }
</script>

