---
import Layout from "../layouts/Layout.astro";
import PassengerFaq from "../components/PassengerFaq.astro";
---

<Layout title="Informations passagers" description="Toutes les réponses pratiques avant le grand jour — mariage de Lisa & Ryan.">
  <section class="px-6 sm:px-10 pt-32 sm:pt-40 pb-16 sm:pb-20 bg-sauge text-center texture-grain">
    <p class="eyebrow text-ivoire/85 text-xs sm:text-sm hero-enter" style="animation-delay:.05s">Avant le départ…</p>
    <h1 class="font-serif text-4xl sm:text-6xl text-ivoire font-medium mt-3 hero-enter" style="animation-delay:.15s">Informations passagers</h1>
  </section>

  <PassengerFaq />
</Layout>
